{
  "name": "rebuild-b",
  "private": true,
  "version": "1.0.0",
  "description": "MenEZmanim rebuild arm B",
  "scripts": {
    "dev": "next dev --port 3102",
    "build": "prisma generate && next build",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "prisma db push && prisma db seed",
    "desktop:start": "npm --prefix desktop start",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "desktop:dist": "npm run build && npm --prefix desktop run dist"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "kosher-zmanim": "0.9.0",
    "luxon": "3.7.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "svix": "1.96.1",
    "zod": "3.25.76",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "prisma": "6.19.3",
    "tsx": "4.20.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
