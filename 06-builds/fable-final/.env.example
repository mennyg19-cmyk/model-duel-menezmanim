# Database. Unset = local file at local-data/dev.db (Phase 1 default).
# For sqld/Turso set a libsql:// url + auth token. Local sqld would run on port 8101.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Auth (Phase 3). session = email/password HMAC cookie (experiment default).
# clerk = when NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is set. local = keyless super-admin.
AUTH_MODE=session
AUTH_SECRET=rebuild-a-dev-secret-change-me
SUPER_ADMIN_EMAILS=owner@demo.local

# Optional Clerk (leave empty in experiment).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=
